# Copia este archivo como .env.local. Nunca compartas valores reales en Git.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Opcional si usas dominio propio. Sin barra final.
# APP_ORIGIN="https://nuestro-dominio.example"

# Solo para el asistente local: nunca se copian al servidor ni a Git.
# También puedes introducirlos en la terminal cuando el asistente los pida.
# VERCEL_PROJECT_ID="prj_..."
# VERCEL_TEAM_ID="team_..."
# VERCEL_TOKEN="token-temporal-del-equipo"
