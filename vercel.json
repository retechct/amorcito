{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/router.mjs": { "maxDuration": 60, "excludeFiles": "{.private/**,private-media/**,.env*,.qa/**,tests/**,*.jpg,*.JPG,*.png,*.HEIC,*.zip}" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/router?route=:path*" },
    { "source": "/media/:file", "destination": "/api/router?media=:file" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://api.cloudinary.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
    ] }
  ]
}
